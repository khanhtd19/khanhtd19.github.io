---

<!-- Full-page Cosmic Starfield Canvas (PRD Section 4 & Phase 6) -->
<canvas id="cosmic-starfield" class="cosmic-starfield-canvas" aria-hidden="true"></canvas>

<style>
  .cosmic-starfield-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: -2;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .cosmic-starfield-canvas {
      opacity: 0.6;
    }
  }
</style>

<script>
  interface Star {
    x: number;
    y: number;
    size: number;
    baseAlpha: number;
    alpha: number;
    twinkleSpeed: number;
    twinkleOffset: number;
    speedY: number;
    color: string;
    layer: number;
  }

  interface ShootingStar {
    x: number;
    y: number;
    length: number;
    speed: number;
    angle: number;
    alpha: number;
    active: boolean;
  }

  const canvas = document.getElementById('cosmic-starfield') as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = 0;
    let height = 0;
    let stars: Star[] = [];
    let shootingStar: ShootingStar | null = null;
    let lastShootingStarTime = 0;
    let animId = 0;
    let isTabVisible = true;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resize() {
      if (!canvas) return;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    }

    function initStars() {
      stars = [];
      // Adjust star count for mobile screens (PRD Section 4)
      const isMobile = width < 768;
      const count = isMobile ? 45 : 130;

      const starColors = [
        '#FFFFFF',
        '#EAF2FF',
        '#55D6FF', // Cosmic cyan
        '#A78BFA', // Cosmic violet
        '#648BFF', // Electric blue
      ];

      for (let i = 0; i < count; i++) {
        const layer = Math.random(); // 0 to 1
        const size = layer > 0.8 ? Math.random() * 1.5 + 1.2 : Math.random() * 1.2 + 0.6;
        const baseAlpha = layer > 0.8 ? 0.7 : Math.random() * 0.4 + 0.2;

        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          size: size,
          baseAlpha: baseAlpha,
          alpha: baseAlpha,
          twinkleSpeed: Math.random() * 0.03 + 0.01,
          twinkleOffset: Math.random() * Math.PI * 2,
          speedY: (1 - layer) * 0.15 + 0.05, // Subtle parallax vertical drift
          color: starColors[Math.floor(Math.random() * starColors.length)],
          layer: layer,
        });
      }
    }

    function spawnShootingStar() {
      const startX = Math.random() * (width * 0.75);
      const startY = Math.random() * (height * 0.4);
      shootingStar = {
        x: startX,
        y: startY,
        length: Math.random() * 80 + 60,
        speed: Math.random() * 8 + 9,
        angle: (Math.PI / 4) + (Math.random() * 0.2 - 0.1), // ~45 degrees diagonal
        alpha: 1,
        active: true,
      };
    }

    function render(timestamp: number) {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Render Static / Twinkling Stars
      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];

        if (!prefersReducedMotion) {
          // Drifting
          s.y -= s.speedY;
          if (s.y < 0) {
            s.y = height;
            s.x = Math.random() * width;
          }

          // Twinkle formula
          s.alpha = s.baseAlpha + Math.sin(timestamp * s.twinkleSpeed * 0.05 + s.twinkleOffset) * 0.25;
          s.alpha = Math.max(0.1, Math.min(1, s.alpha));
        }

        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fillStyle = s.color;
        ctx.globalAlpha = s.alpha;

        // Subtle glow for near stars
        if (s.layer > 0.85) {
          ctx.shadowBlur = 6;
          ctx.shadowColor = s.color;
        } else {
          ctx.shadowBlur = 0;
        }

        ctx.fill();
      }

      ctx.shadowBlur = 0;
      ctx.globalAlpha = 1;

      // Render Shooting Star (Meteor)
      if (!prefersReducedMotion) {
        if (!shootingStar && timestamp - lastShootingStarTime > 7000 + Math.random() * 6000) {
          spawnShootingStar();
          lastShootingStarTime = timestamp;
        }

        if (shootingStar && shootingStar.active) {
          const dx = Math.cos(shootingStar.angle) * shootingStar.speed;
          const dy = Math.sin(shootingStar.angle) * shootingStar.speed;

          shootingStar.x += dx;
          shootingStar.y += dy;
          shootingStar.alpha -= 0.015;

          if (shootingStar.alpha <= 0 || shootingStar.x > width || shootingStar.y > height) {
            shootingStar.active = false;
            shootingStar = null;
          } else {
            const tailX = shootingStar.x - Math.cos(shootingStar.angle) * shootingStar.length;
            const tailY = shootingStar.y - Math.sin(shootingStar.angle) * shootingStar.length;

            const grad = ctx.createLinearGradient(tailX, tailY, shootingStar.x, shootingStar.y);
            grad.addColorStop(0, 'rgba(85, 214, 255, 0)');
            grad.addColorStop(0.7, 'rgba(100, 139, 255, 0.4)');
            grad.addColorStop(1, `rgba(234, 242, 255, ${shootingStar.alpha})`);

            ctx.beginPath();
            ctx.moveTo(tailX, tailY);
            ctx.lineTo(shootingStar.x, shootingStar.y);
            ctx.strokeStyle = grad;
            ctx.lineWidth = 1.8;
            ctx.shadowBlur = 10;
            ctx.shadowColor = '#55D6FF';
            ctx.stroke();
            ctx.shadowBlur = 0;
          }
        }
      }

      if (!prefersReducedMotion && isTabVisible) {
        animId = requestAnimationFrame(render);
      }
    }

    // Page Visibility handling
    document.addEventListener('visibilitychange', () => {
      isTabVisible = !document.hidden;
      if (isTabVisible && !prefersReducedMotion) {
        animId = requestAnimationFrame(render);
      } else {
        cancelAnimationFrame(animId);
      }
    });

    // Resize handling with debounce
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        resize();
        initStars();
        if (prefersReducedMotion) render(0);
      }, 150);
    });

    // Initial setup
    resize();
    initStars();
    if (prefersReducedMotion) {
      render(0); // Draw once static
    } else {
      animId = requestAnimationFrame(render);
    }
  }
</script>
