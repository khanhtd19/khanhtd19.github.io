---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileData } from '../data/profile';
import { skillsGroups } from '../data/skills';
---

<BaseLayout
  title={`Về Tác Giả — ${profileData.name} | IT UNIVERSE`}
  description={`Hồ sơ cá nhân, kinh nghiệm lập trình, lộ trình học vấn và định hướng phát triển của ${profileData.name}.`}
>
  <div class="container about-page">
    <!-- Top Hero Header / Profile Overview -->
    <section class="about-hero-section scroll-reveal">
      <div class="glass-card profile-card">
        <div class="profile-layout">
          <!-- Avatar Column -->
          <div class="avatar-col">
            <div class="avatar-wrapper">
              <div class="avatar-glow"></div>
              <div class="avatar-inner">
                <!-- Cosmic Developer Avatar SVG -->
                <svg viewBox="0 0 160 160" fill="none" class="avatar-svg" xmlns="http://www.w3.org/2000/svg">
                  <rect width="160" height="160" rx="80" fill="url(#avatarBgGrad)" />
                  <!-- Star particles inside avatar -->
                  <circle cx="35" cy="40" r="1.5" fill="#55D6FF" opacity="0.8" />
                  <circle cx="125" cy="35" r="2" fill="#A78BFA" opacity="0.7" />
                  <circle cx="130" cy="110" r="1.5" fill="#55D6FF" opacity="0.6" />
                  <circle cx="30" cy="120" r="2" fill="#EAF2FF" opacity="0.5" />
                  
                  <!-- Astronaut / Tech Dev Helm -->
                  <circle cx="80" cy="72" r="38" fill="#121C34" stroke="url(#helmStroke)" stroke-width="3" />
                  <!-- Visor reflecting cosmic cyan -->
                  <ellipse cx="80" cy="72" rx="26" ry="18" fill="url(#visorGrad)" />
                  <ellipse cx="74" cy="68" rx="8" ry="4" fill="white" opacity="0.4" transform="rotate(-15 74 68)" />
                  <!-- Suit Collar / Body -->
                  <path d="M42 135C42 115 58 106 80 106C102 106 118 115 118 135V160H42V135Z" fill="#182544" stroke="#648BFF" stroke-width="2" />
                  <path d="M68 116H92" stroke="#55D6FF" stroke-width="3" stroke-linecap="round" />
                  <circle cx="80" cy="130" r="4" fill="#55D6FF" />

                  <defs>
                    <radialGradient id="avatarBgGrad" cx="50%" cy="40%" r="60%">
                      <stop offset="0%" stop-color="#1E2E55" />
                      <stop offset="60%" stop-color="#0D1428" />
                      <stop offset="100%" stop-color="#070B18" />
                    </radialGradient>
                    <linearGradient id="helmStroke" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#55D6FF" />
                      <stop offset="100%" stop-color="#A78BFA" />
                    </linearGradient>
                    <linearGradient id="visorGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#55D6FF" />
                      <stop offset="60%" stop-color="#648BFF" />
                      <stop offset="100%" stop-color="#121C34" />
                    </linearGradient>
                  </defs>
                </svg>
              </div>
              <!-- Floating status badge -->
              <div class="avatar-status-pill">
                <span class="status-live-dot"></span>
                <span>Active</span>
              </div>
            </div>
          </div>

          <!-- Profile Details Column -->
          <div class="profile-info-col">
            <div class="badge-row">
              <span class="cosmic-badge">KỸ SƯ PHẦN MỀM</span>
              <span class="location-badge text-mono">📍 {profileData.location}</span>
            </div>

            <h1 class="profile-name">
              {profileData.name} — <span class="text-gradient">{profileData.role}</span>
            </h1>

            <p class="profile-tagline">{profileData.tagline}</p>

            <div class="bio-paragraphs">
              {profileData.detailedBio.map((paragraph) => (
                <p class="bio-text">{paragraph}</p>
              ))}
            </div>

            <!-- Career Orientation Callout -->
            <div class="orientation-box">
              <h3 class="orientation-heading">✦ Định hướng nghề nghiệp</h3>
              <p class="orientation-text">{profileData.careerOrientation}</p>
            </div>

            <div class="profile-actions">
              <a href="/contact" class="btn-cosmic-primary">
                <span>Liên hệ hợp tác</span>
                <span class="btn-arrow">→</span>
              </a>
              <a href="/projects" class="btn-cosmic-outline">
                <span>Xem các dự án đã làm</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Education Section (PRD Section 2.2) -->
    <section class="about-section scroll-reveal">
      <div class="section-title-wrap">
        <span class="cosmic-badge">ACADEMIC BACKGROUND</span>
        <h2 class="section-title">Thông Tin <span class="text-gradient">Học Tập</span></h2>
      </div>

      <div class="education-grid">
        {profileData.education.map((edu) => (
          <div class="glass-card education-card">
            <div class="edu-icon-col">
              <div class="edu-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                  <path d="M6 12v5c3 3 9 3 12 0v-5" />
                </svg>
              </div>
            </div>
            <div class="edu-info-col">
              <div class="edu-header">
                <h3 class="edu-degree">{edu.degree}</h3>
                <span class="edu-period text-mono">{edu.period}</span>
              </div>
              <h4 class="edu-institution">{edu.institution}</h4>
              <p class="edu-desc">{edu.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Timeline Quá trình Phát triển (PRD Section 2.2) -->
    <section class="about-section scroll-reveal">
      <div class="section-title-wrap">
        <span class="cosmic-badge">GROWTH MILESTONES</span>
        <h2 class="section-title">Lộ Trình <span class="text-gradient">Phát Triển</span></h2>
        <p class="section-sub">Dòng thời gian ghi dấu quá trình học tập, rèn luyện kỹ năng và các cột mốc thực hành dự án.</p>
      </div>

      <div class="timeline-container">
        <div class="timeline-line" aria-hidden="true"></div>
        {profileData.timeline.map((item, index) => (
          <div class="timeline-item scroll-reveal">
            <div class="timeline-dot">
              <div class="timeline-dot-inner"></div>
            </div>
            <div class="glass-card timeline-content">
              <div class="timeline-meta">
                <span class="timeline-year text-mono">{item.year}</span>
                {item.badge && <span class="timeline-badge text-mono">{item.badge}</span>}
              </div>
              <h3 class="timeline-title">{item.title}</h3>
              <h4 class="timeline-org">{item.organization}</h4>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical Skills Section (PRD Section 2.2) -->
    <section class="about-section scroll-reveal" id="skills">
      <div class="section-title-wrap">
        <span class="cosmic-badge">TECHNICAL CAPABILITIES</span>
        <h2 class="section-title">Kỹ Năng <span class="text-gradient">Chuyên Môn</span></h2>
        <p class="section-sub">Tổng hợp các ngôn ngữ, thư viện, công cụ và quy trình làm việc kỹ thuật số.</p>
      </div>

      <div class="skills-grid">
        {skillsGroups.map((group, idx) => (
          <div class:list={['glass-card skill-group-card scroll-reveal', `reveal-delay-${idx + 1}`]}>
            <div class="group-header">
              <h3 class="group-title">{group.name}</h3>
              <p class="group-desc">{group.description}</p>
            </div>
            <div class="skill-items-list">
              {group.skills.map((skill) => (
                <div class:list={['skill-row', { 'is-highlight': skill.highlight }]}>
                  <div class="skill-name-col">
                    <span class="skill-icon">✦</span>
                    <span class="skill-label">{skill.name}</span>
                  </div>
                  <span class="skill-level-badge text-mono">{skill.level}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Future Goals Section (PRD Section 2.2) -->
    <section class="about-section scroll-reveal">
      <div class="section-title-wrap">
        <span class="cosmic-badge">VISION & FUTURE</span>
        <h2 class="section-title">Mục Tiêu <span class="text-gradient">Tương Lai</span></h2>
      </div>

      <div class="goals-grid">
        {profileData.futureGoals.map((goal) => (
          <div class="glass-card goal-card">
            <div class="goal-header">
              <span class:list={['goal-tag text-mono', goal.category === 'Short-term' ? 'tag-short' : 'tag-long']}>
                {goal.category === 'Short-term' ? 'Ngắn hạn' : 'Dài hạn'}
              </span>
            </div>
            <h3 class="goal-title">{goal.target}</h3>
            <p class="goal-desc">{goal.description}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .about-section {
    margin-top: 5rem;
  }

  .section-title-wrap {
    margin-bottom: 2.5rem;
  }

  .section-title {
    margin-top: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .section-sub {
    color: var(--color-muted-text);
    max-width: 650px;
  }

  /* Profile Card Top */
  .profile-card {
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .profile-card {
      padding: 3.5rem;
    }
  }

  .profile-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 850px) {
    .profile-layout {
      grid-template-columns: 220px 1fr;
      gap: 3.5rem;
    }
  }

  /* Avatar */
  .avatar-col {
    display: flex;
    justify-content: center;
  }

  .avatar-wrapper {
    position: relative;
    width: 170px;
    height: 170px;
  }

  @media (min-width: 850px) {
    .avatar-wrapper {
      width: 200px;
      height: 200px;
    }
  }

  .avatar-glow {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-cyan-glow) 0%, var(--color-violet-glow) 50%, transparent 70%);
    filter: blur(15px);
    z-index: 0;
  }

  .avatar-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid var(--color-border-glow);
    overflow: hidden;
    z-index: 1;
    background: var(--color-deep-space);
  }

  .avatar-svg {
    width: 100%;
    height: 100%;
  }

  .avatar-status-pill {
    position: absolute;
    bottom: 5px;
    right: 5px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--color-starlight);
    background: rgba(18, 28, 52, 0.95);
    border: 1px solid var(--color-border-glow);
    border-radius: var(--radius-full);
  }

  .status-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 6px #10B981;
  }

  /* Info */
  .profile-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .location-badge {
    font-size: 0.8rem;
    color: var(--color-muted-text);
  }

  .profile-name {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.2;
  }

  .profile-tagline {
    font-size: 1.1rem;
    color: var(--color-cosmic-cyan);
    font-weight: 500;
  }

  .bio-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bio-text {
    color: var(--color-muted-text);
    line-height: 1.7;
    font-size: 0.98rem;
  }

  .orientation-box {
    padding: 1.25rem 1.5rem;
    background: rgba(7, 11, 24, 0.55);
    border-left: 3px solid var(--color-cosmic-cyan);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .orientation-heading {
    font-size: 0.92rem;
    color: var(--color-cosmic-cyan);
    margin-bottom: 0.4rem;
  }

  .orientation-text {
    font-size: 0.92rem;
    color: var(--color-starlight);
    line-height: 1.6;
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
  }
  .btn-cosmic-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Education */
  .education-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .education-card {
    display: flex;
    gap: 1.5rem;
    padding: 2rem;
  }

  .edu-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(85, 214, 255, 0.1);
    border: 1px solid rgba(85, 214, 255, 0.3);
    color: var(--color-cosmic-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .edu-info-col {
    flex: 1 1 auto;
  }

  .edu-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .edu-degree {
    font-size: 1.25rem;
    color: var(--color-starlight);
  }

  .edu-period {
    font-size: 0.85rem;
    color: var(--color-cosmic-cyan);
  }

  .edu-institution {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-muted-text);
    margin-top: 0.2rem;
    margin-bottom: 0.6rem;
  }

  .edu-desc {
    font-size: 0.9rem;
    color: var(--color-muted-text);
    line-height: 1.6;
  }

  /* Timeline */
  .timeline-container {
    position: relative;
    padding-left: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .timeline-container {
      padding-left: 2.5rem;
    }
  }

  .timeline-line {
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 8px;
    width: 2px;
    background: linear-gradient(180deg, var(--color-cosmic-cyan) 0%, var(--color-cosmic-violet) 70%, transparent 100%);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 1.5rem;
    transform: translateX(-50%);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-deep-space);
    border: 2px solid var(--color-cosmic-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 10px var(--color-cosmic-cyan);
  }

  @media (min-width: 768px) {
    .timeline-dot {
      left: -2.5rem;
    }
  }

  .timeline-dot-inner {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-cosmic-cyan);
  }

  .timeline-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .timeline-year {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-cosmic-cyan);
  }

  .timeline-badge {
    font-size: 0.72rem;
    color: var(--color-cosmic-violet);
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid rgba(167, 139, 250, 0.25);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .timeline-title {
    font-size: 1.2rem;
  }

  .timeline-org {
    font-size: 0.9rem;
    color: var(--color-muted-text);
    font-weight: 500;
  }

  .timeline-desc {
    font-size: 0.92rem;
    color: var(--color-muted-text);
    line-height: 1.6;
  }

  /* Skills Grid */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-group-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .group-title {
    font-size: 1.2rem;
    margin-bottom: 0.3rem;
  }

  .group-desc {
    font-size: 0.82rem;
    color: var(--color-muted-text);
    line-height: 1.5;
  }

  .skill-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .skill-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.75rem;
    background: rgba(7, 11, 24, 0.5);
    border: 1px solid rgba(154, 170, 196, 0.08);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .skill-row:hover {
    border-color: var(--color-border-glow);
    background: rgba(18, 28, 52, 0.7);
  }

  .skill-row.is-highlight {
    border-left: 2px solid var(--color-cosmic-cyan);
  }

  .skill-name-col {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .skill-icon {
    color: var(--color-cosmic-cyan);
    font-size: 0.65rem;
  }

  .skill-label {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-starlight);
  }

  .skill-level-badge {
    font-size: 0.72rem;
    color: var(--color-muted-text);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  /* Future Goals */
  .goals-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .goals-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .goal-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .goal-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .tag-short {
    color: var(--color-cosmic-cyan);
    background: rgba(85, 214, 255, 0.1);
    border: 1px solid rgba(85, 214, 255, 0.25);
  }

  .tag-long {
    color: var(--color-cosmic-violet);
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid rgba(167, 139, 250, 0.25);
  }

  .goal-title {
    font-size: 1.15rem;
  }

  .goal-desc {
    font-size: 0.9rem;
    color: var(--color-muted-text);
    line-height: 1.6;
  }
</style>
