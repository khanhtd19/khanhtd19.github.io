---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Mất Tín Hiệu | IT UNIVERSE" description="Không tìm thấy trang yêu cầu trong vũ trụ số.">
  <div class="container error-container">
    <div class="glass-card error-card">
      <span class="cosmic-badge">ERROR 404</span>
      <h1 class="error-code text-gradient">404</h1>
      <h2 class="error-title">Mất Tín Hiệu Không Gian</h2>
      <p class="error-desc">
        Toạ độ bạn đang tìm kiếm không tồn tại hoặc đã bị trôi dạt vào hố đen vũ trụ.
      </p>
      <div class="error-actions">
        <a href="/" class="btn-cosmic-primary">
          <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
          </svg>
          <span>Trở về Trang chủ</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    min-height: calc(100vh - var(--header-height) - 300px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
  }
  .error-card {
    max-width: 550px;
    width: 100%;
    padding: 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }
  .error-code {
    font-size: clamp(4rem, 12vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    font-family: var(--font-mono);
  }
  .error-title {
    font-size: 1.6rem;
  }
  .error-desc {
    color: var(--color-muted-text);
    font-size: 1rem;
    line-height: 1.6;
  }
  .error-actions {
    margin-top: 1rem;
  }
</style>
